{
  "files.associations": {
    "*.s": "riscv",
    "*.S": "riscv"
  },

  "riscv-venus.variableFormat": "hex",
  "riscv-venus.maxSteps": -1,
  "riscv-venus.mutableText": true,
  "riscv-venus.setRegesOnInit": true,
  "riscv-venus.forceAlignedAddressing": false,
  "riscv-venus.ecallOnlyExit": false,

  "[riscv]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  }
}